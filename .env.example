# Copy to .env and fill in your values:
#   cp .env.example .env
#
# Expo: only EXPO_PUBLIC_* variables are embedded in the client bundle.
# Never put service_role or secret keys here — anon key only.

# Supabase — Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Support inbox shown in Contact Support screen
EXPO_PUBLIC_SUPPORT_EMAIL=support@yourdomain.com
